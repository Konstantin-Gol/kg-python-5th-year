let picture = 0
let p1_pressed = 0
let p2_pressed = 0
let start = 0
let end = 0
input.onPinPressed(TouchPin.P0, function () {
    picture = 0
    basic.showNumber(3)
    basic.showNumber(2)
    basic.showNumber(1)
    basic.clearScreen()
    p1_pressed = 0
    p2_pressed = 0
    basic.pause(randint(500, 2000))
    picture = 1
    start = input.runningTime()
    basic.showLeds(`
        . . # . .
        . . # . .
        . . # . .
        . . . . .
        . . # . .
        `)
})
input.onPinPressed(TouchPin.P2, function () {
    p2_pressed = 1
    if (p1_pressed == 1) {
    	
    } else {
        if (p2_pressed == picture) {
            end = input.runningTime()
            basic.showLeds(`
                . . . # #
                . . . # #
                . . . # #
                . . . # #
                . . . # #
                `)
            basic.pause(500)
            basic.showNumber(end - start)
        } else if (p2_pressed != picture) {
            end = input.runningTime()
            basic.showLeds(`
                # # . . .
                # # . . .
                # # . . .
                # # . . .
                # # . . .
                `)
            basic.pause(500)
            basic.showNumber(end - start)
        }
    }
})
